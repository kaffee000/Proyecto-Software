<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head') %>
    <title><%= title %></title>
</head>
<body class="min-h-screen bg-white font-sans text-muni-ink antialiased">
    <%- include('partials/navigation') %>

    <main id="contenido-principal" class="flex-grow">
        <%
            const listaInicio = Array.isArray(actividades) ? actividades : [];
            const fechaActual = Date.now();
            const actividadDestacada = listaInicio.find((item) => item.estado === "activo" && new Date(item.fecha).getTime() >= fechaActual)
                || null;
            const fechaDestacada = actividadDestacada ? new Date(actividadDestacada.fecha) : null;
            const fechaDestacadaValida = fechaDestacada && !Number.isNaN(fechaDestacada.getTime());
            const fechaDestacadaTexto = fechaDestacadaValida
                ? new Intl.DateTimeFormat("es-CL", {
                    weekday: "long", day: "numeric", month: "long", hour: "2-digit", minute: "2-digit",
                    timeZone: "America/Santiago", hourCycle: "h23"
                }).format(fechaDestacada)
                : "Fecha por confirmar";
            const imagenHero = "/images/portada.jpg";
        %>

        <section class="px-4 pb-12 pt-3 md:px-7 md:pb-20 lg:px-0 lg:pb-0 lg:pt-0" aria-labelledby="hero-heading">
            <div class="relative mx-auto overflow-hidden rounded-[24px] bg-white lg:mx-6 lg:min-h-[calc(100svh-82px)] lg:w-auto lg:max-w-none lg:rounded-[24px] lg:bg-muni-ink">
                <div class="absolute inset-0 z-[1] hidden bg-gradient-to-r from-black/75 via-black/35 to-transparent lg:block"></div>
                <div class="absolute inset-0 z-[1] hidden bg-gradient-to-t from-black/55 via-transparent to-black/10 lg:block"></div>

                <div class="relative z-10 flex items-center bg-white px-6 py-10 sm:px-10 sm:py-12 lg:min-h-[calc(100svh-82px)] lg:bg-transparent lg:px-16 lg:pb-24">
                    <div class="max-w-3xl lg:text-white">
                        <h1 id="hero-heading" class="max-w-[13ch] text-[clamp(2.65rem,7.1vw,5rem)] font-medium leading-[0.99] tracking-[-0.04em] text-muni-ink text-balance lg:text-white">
                            El deporte y la vida sana se viven en los barrios de Talca.
                        </h1>
                        <p class="mt-6 max-w-[58ch] text-base leading-7 text-muni-muted sm:text-lg sm:leading-8 lg:text-white/90">
                            Encuentra talleres, encuentros y espacios para moverte en comunidad.
                        </p>
                        <div class="mt-8 flex flex-wrap gap-3">
                            <a href="#catalogo-actividades" class="inline-flex min-h-12 items-center justify-center gap-3 rounded-full bg-muni-red-dark px-6 text-sm font-semibold text-white transition-transform hover:-translate-y-0.5 hover:bg-red-800 focus-visible:outline-white">
                                Explorar la cartelera
                                <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M5 12h14M13 6l6 6-6 6"></path>
                                </svg>
                            </a>
                            <a href="#recintos-deportivos" class="inline-flex min-h-12 items-center justify-center rounded-full border border-black/20 px-6 text-sm font-medium text-muni-ink transition-colors hover:bg-black/5 lg:border-white/70 lg:text-white lg:hover:bg-white/10 focus-visible:outline-white">
                                Conocer los recintos
                            </a>
                        </div>
                    </div>
                </div>

                <img src="<%= imagenHero %>" alt="" class="relative z-0 block h-[220px] w-full object-cover sm:h-[320px] lg:absolute lg:inset-0 lg:h-full" fetchpriority="high" width="1600" height="900">

                <% if (actividadDestacada) { %>
                    <aside class="relative z-20 mx-4 mb-4 w-auto rounded-2xl bg-[#8f2632] p-5 text-white shadow-[0_18px_50px_-22px_rgba(0,0,0,0.5)] sm:mx-6 sm:mb-6 sm:p-6 lg:absolute lg:inset-x-auto lg:bottom-10 lg:right-10 lg:mx-0 lg:mb-0 lg:w-[min(27rem,45%)]" aria-label="Próxima actividad en la cartelera">
                        <div class="flex items-start justify-between gap-4">
                            <div class="min-w-0">
                                <h2 class="text-xl font-semibold leading-tight tracking-[-0.035em] sm:text-2xl"><%= actividadDestacada.nombre %></h2>
                            </div>
                            <span class="mt-0.5 shrink-0 rounded-full bg-white/15 px-3 py-1.5 text-[11px] font-semibold text-white"><%= actividadDestacada.categoria %></span>
                        </div>
                        <div class="mt-5 space-y-2 border-t border-white/20 pt-4 text-sm text-white/85">
                            <p class="flex items-start gap-2.5">
                                <svg aria-hidden="true" class="mt-0.5 h-4 w-4 shrink-0 text-white/80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M16 3v4M8 3v4M3 10h18"></path>
                                </svg>
                                <time datetime="<%= fechaDestacadaValida ? fechaDestacada.toISOString() : '' %>"><%= fechaDestacadaTexto %></time>
                            </p>
                            <p class="flex items-start gap-2.5">
                                <svg aria-hidden="true" class="mt-0.5 h-4 w-4 shrink-0 text-white/80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"></path><circle cx="12" cy="10" r="2.5"></circle>
                                </svg>
                                <span><%= actividadDestacada.lugar || "Recinto por confirmar" %></span>
                            </p>
                        </div>
                        <a href="#catalogo-actividades" class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-white underline decoration-white/40 underline-offset-4 hover:decoration-white">
                            Ver en la cartelera
                            <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
                        </a>
                    </aside>
                <% } else { %>
                    <aside class="relative z-20 mx-4 mb-4 rounded-2xl bg-[#8f2632] p-5 text-white sm:mx-6 sm:mb-6 sm:p-6 lg:absolute lg:inset-x-auto lg:bottom-10 lg:right-10 lg:mx-0 lg:mb-0 lg:w-[min(27rem,45%)]">
                        <h2 class="text-lg font-semibold tracking-[-0.03em]">La cartelera se está actualizando</h2>
                        <p class="mt-2 text-sm leading-6 text-white/85">Pronto encontrarás aquí las próximas actividades de Talca.</p>
                    </aside>
                <% } %>
            </div>
        </section>

        <%- include('partials/catalogo', { catalogoMode: 'home' }) %>

        <section id="recintos-deportivos" class="scroll-mt-8 border-y border-black/10 bg-muni-soft px-4 py-16 md:px-7 md:py-24" aria-labelledby="recintos-heading">
            <div class="mx-auto grid max-w-[1280px] gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
                <div class="max-w-xl">
                    <h2 id="recintos-heading" class="text-3xl font-semibold leading-tight tracking-[-0.04em] text-muni-ink sm:text-4xl">Un lugar para moverse, cerca de tu barrio.</h2>
                    <p class="mt-4 text-base leading-7 text-muni-muted">Las actividades municipales se encuentran en recintos y espacios comunitarios de Talca.</p>
                    <a href="/contact" class="mt-7 inline-flex items-center gap-2 border-b border-muni-red pb-1 text-sm font-semibold text-muni-ink hover:text-muni-red-dark">
                        Consultar por un recinto
                        <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
                    </a>
                </div>

                <div class="border-t border-black/15">
                    <article class="grid gap-4 border-b border-black/15 py-5 sm:grid-cols-[8rem_1fr] sm:gap-6">
                        <img src="/images/actividad de deporte.jpg" alt="Actividad deportiva en el Polideportivo Municipal" class="h-28 w-full rounded-xl object-cover sm:h-24 sm:w-32" width="320" height="180" loading="lazy">
                        <div>
                            <h3 class="text-lg font-semibold tracking-[-0.025em]">Polideportivo Municipal</h3>
                            <p class="mt-1 text-sm text-muni-muted">Calle 4 Norte con 16 Oriente · Básquetbol y vóleibol</p>
                        </div>
                    </article>
                    <article class="grid gap-4 border-b border-black/15 py-5 sm:grid-cols-[8rem_1fr] sm:gap-6">
                        <img src="/images/actividad baile en piscina.jpeg" alt="Actividad acuática en piscina municipal" class="h-28 w-full rounded-xl object-cover sm:h-24 sm:w-32" width="320" height="180" loading="lazy">
                        <div>
                            <h3 class="text-lg font-semibold tracking-[-0.025em]">Piscina Municipal</h3>
                            <p class="mt-1 text-sm text-muni-muted">Piscina temperada · Hidrogimnasia y bienestar acuático</p>
                        </div>
                    </article>
                    <article class="grid gap-4 border-b border-black/15 py-5 sm:grid-cols-[8rem_1fr] sm:gap-6">
                        <img src="/images/actividad baile entretenido.jpg" alt="Baile entretenido al aire libre en Talca" class="h-28 w-full rounded-xl object-cover sm:h-24 sm:w-32" width="320" height="180" loading="lazy">
                        <div>
                            <h3 class="text-lg font-semibold tracking-[-0.025em]">Parque Costanera Río Claro</h3>
                            <p class="mt-1 text-sm text-muni-muted">Espacio comunitario al aire libre · Baile y vida activa</p>
                        </div>
                    </article>
                </div>
            </div>
        </section>

        <section class="px-4 py-16 md:px-7 md:py-24" aria-labelledby="participar-heading">
            <div class="mx-auto grid max-w-[1280px] gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
                <div>
                    <h2 id="participar-heading" class="text-3xl font-semibold leading-tight tracking-[-0.04em] text-muni-ink sm:text-4xl">Tu próxima actividad, en pocos pasos.</h2>
                    <p class="mt-4 max-w-lg text-base leading-7 text-muni-muted">La cartelera reúne los datos necesarios para que puedas elegir y participar.</p>
                </div>
                <ol class="border-t border-black/15">
                    <li class="grid grid-cols-[2rem_1fr] gap-4 border-b border-black/15 py-5">
                        <span class="pt-0.5 text-sm font-semibold tabular-nums text-muni-red-dark">01</span>
                        <div>
                            <h3 class="font-semibold text-muni-ink">Explora la cartelera</h3>
                            <p class="mt-1 text-sm leading-6 text-muni-muted">Filtra por deporte, salud o actividades sociales y revisa cuándo se realiza.</p>
                        </div>
                    </li>
                    <li class="grid grid-cols-[2rem_1fr] gap-4 border-b border-black/15 py-5">
                        <span class="pt-0.5 text-sm font-semibold tabular-nums text-muni-red-dark">02</span>
                        <div>
                            <h3 class="font-semibold text-muni-ink">Confirma el recinto y los cupos</h3>
                            <p class="mt-1 text-sm leading-6 text-muni-muted">Cada actividad muestra su lugar y los cupos disponibles, que bajan al confirmar una inscripción.</p>
                        </div>
                    </li>
                    <li class="grid grid-cols-[2rem_1fr] gap-4 border-b border-black/15 py-5">
                        <span class="pt-0.5 text-sm font-semibold tabular-nums text-muni-red-dark">03</span>
                        <div>
                            <h3 class="font-semibold text-muni-ink">Confirma tu inscripción</h3>
                            <p class="mt-1 text-sm leading-6 text-muni-muted">Reserva un cupo disponible desde la cartelera con tu cuenta vecinal.</p>
                        </div>
                    </li>
                </ol>
            </div>
        </section>

        <section class="bg-muni-red-dark px-4 py-12 text-white md:px-7 md:py-16" aria-labelledby="ayuda-heading">
            <div class="mx-auto flex max-w-[1280px] flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
                <div>
                    <h2 id="ayuda-heading" class="text-2xl font-semibold tracking-[-0.035em] sm:text-3xl">¿Necesitas orientación?</h2>
                    <p class="mt-2 max-w-2xl text-sm leading-6 text-white/90 sm:text-base">El equipo municipal puede ayudarte con la cartelera, los recintos y la información de inscripción.</p>
                </div>
                <a href="/contact" class="inline-flex min-h-12 w-fit shrink-0 items-center gap-3 rounded-full bg-white px-6 text-sm font-semibold text-muni-ink transition-colors hover:bg-red-50">
                    Contactar
                    <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
                </a>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
