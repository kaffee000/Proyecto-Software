<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head') %>
    <title><%= title %></title>
</head>
<body class="bg-slate-50 text-slate-900 font-sans antialiased min-h-screen flex flex-col">
    <%- include('partials/navigation') %>

    <main id="contenido-principal" class="flex-grow">
        <!-- Encabezado de Página -->
        <header class="bg-white border-b border-slate-200 py-10 px-4">
            <div class="max-w-7xl mx-auto">
                <nav class="flex items-center gap-2 text-xs font-semibold text-slate-500 mb-3" aria-label="Ruta de navegación">
                    <a href="/" class="hover:text-red-600 transition">Inicio</a>
                    <span>/</span>
                    <span class="text-slate-900">Equipo Profesional</span>
                </nav>

                <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight mb-2">
                    Especialistas y Monitores Comunitarios
                </h1>
                <p class="text-sm sm:text-base text-slate-600 max-w-2xl">
                    Conoce al equipo de profesores, preparadores físicos, kinesiólogos y guías que acompañan los talleres deportivos en Talca.
                </p>
            </div>
        </header>

        <section class="max-w-7xl mx-auto px-4 py-12">
            <% if (!profesionales || profesionales.length === 0) { %>
                <!-- Estado informativo cuando la BD aún no cuenta con registros -->
                <div class="bg-white rounded-2xl border border-dashed border-slate-300 p-10 text-center max-w-xl mx-auto mb-16 shadow-sm" role="status">
                    <div class="w-16 h-16 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mx-auto mb-4">
                        <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                    </div>
                    <h2 class="text-lg font-bold text-slate-900 mb-2">Directorio profesional en preparación</h2>
                    <p class="text-sm text-slate-600 mb-6 leading-relaxed">
                        El registro individualizado de especialistas y monitores municipales se encuentra en fase de integración. Próximamente podrás revisar los perfiles de los profesionales asignados a cada taller.
                    </p>
                    <div class="flex flex-wrap justify-center gap-3">
                        <a href="/event" class="px-4 py-2.5 rounded-xl text-sm font-bold text-white bg-red-600 hover:bg-red-700 transition">
                            Explorar cartelera oficial
                        </a>
                        <a href="/contact" class="px-4 py-2.5 rounded-xl text-sm font-bold text-slate-800 bg-white border border-slate-200 hover:bg-slate-50 transition">
                            Canales de atención
                        </a>
                    </div>
                </div>

                <!-- Estructura del Equipo Municipal -->
                <div>
                    <div class="text-center max-w-xl mx-auto mb-10">
                        <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 mb-2">
                            Especialidades que integran Muni Sport
                        </h2>
                        <p class="text-sm text-slate-600">
                            Profesionales dedicados al bienestar físico y la recreación comunitaria en Talca.
                        </p>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
                            <div class="w-10 h-10 rounded-xl bg-red-50 text-red-600 flex items-center justify-center font-bold mb-4">
                                ED
                            </div>
                            <h3 class="text-base font-bold text-slate-900 mb-2">Profesores de Educación Física</h3>
                            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                                Lideran los talleres formativos infanto-juveniles en polideportivos, promoviendo técnica deportiva y hábitos saludables desde temprana edad.
                            </p>
                        </div>

                        <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
                            <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold mb-4">
                                KI
                            </div>
                            <h3 class="text-base font-bold text-slate-900 mb-2">Kinesiólogos y Preparadores Físicos</h3>
                            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                                Coordinan circuitos de acondicionamiento funcional, hidrogimnasia y adaptación de cargas para el cuidado articular y muscular.
                            </p>
                        </div>

                        <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
                            <div class="w-10 h-10 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center font-bold mb-4">
                                MB
                            </div>
                            <h3 class="text-base font-bold text-slate-900 mb-2">Monitores Barriales y Recreativos</h3>
                            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                                Facilitan el encuentro vecinal, las pausas activas de adultos mayores y las dinámicas familiares en plazas y juntas vecinales de Talca.
                            </p>
                        </div>
                    </div>
                </div>
            <% } else { %>
                <!-- Filtros y Directorio cuando hay datos de BD -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                    <% profesionales.forEach(profesional => { %>
                        <article class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm flex items-center gap-4">
                            <div class="w-12 h-12 rounded-full bg-red-100 text-red-700 font-extrabold text-lg flex items-center justify-center shrink-0">
                                <%= profesional.nombre ? profesional.nombre.charAt(0).toUpperCase() : 'P' %>
                            </div>
                            <div>
                                <span class="text-xs font-bold text-red-600 uppercase tracking-wide">
                                    <%= profesional.profesion || 'Especialista' %>
                                </span>
                                <h3 class="text-base font-bold text-slate-900"><%= profesional.nombre %></h3>
                                <% if (profesional.email) { %>
                                    <p class="text-xs text-slate-500"><%= profesional.email %></p>
                                <% } %>
                            </div>
                        </article>
                    <% }) %>
                </div>
            <% } %>
        </section>
    </main>

    <%- include('partials/footer') %>
</body>
</html>