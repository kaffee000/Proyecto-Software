<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head') %>
    <title><%= title %></title>
</head>
<body class="min-h-screen bg-white font-sans text-muni-ink antialiased">
    <%- include('partials/navigation') %>

    <main id="contenido-principal" class="flex-grow">
        <header class="px-4 pb-10 pt-12 md:px-7 md:pb-14 md:pt-16">
            <div class="mx-auto max-w-[1280px]">
                <nav class="mb-6 flex items-center gap-2 text-xs font-medium text-muni-muted" aria-label="Ruta de navegación">
                    <a href="/" class="hover:text-muni-red-dark">Inicio</a>
                    <span aria-hidden="true">/</span>
                    <span aria-current="page" class="text-muni-ink">Equipo</span>
                </nav>
                <div class="grid gap-5 md:grid-cols-[1fr_0.72fr] md:items-end md:gap-10">
                    <h1 class="max-w-3xl text-4xl font-semibold leading-[1.02] tracking-[-0.04em] sm:text-5xl lg:text-6xl">Personas que acompañan el movimiento.</h1>
                    <p class="max-w-xl text-base leading-7 text-muni-muted md:justify-self-end">Consulta el directorio de profesionales publicado en la base municipal y encuentra orientación para participar.</p>
                </div>
                <div class="mt-9 h-[3px] w-20 bg-muni-red-dark" aria-hidden="true"></div>
            </div>
        </header>

        <section class="px-4 pb-16 md:px-7 md:pb-24" aria-labelledby="equipo-heading">
            <div class="mx-auto max-w-[1280px]">
                <div class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
                    <div>
                        <h2 id="equipo-heading" class="text-2xl font-semibold tracking-[-0.04em] sm:text-3xl">Directorio profesional</h2>
                        <p class="mt-2 text-sm leading-6 text-muni-muted">Los perfiles visibles aquí se consultan desde Supabase.</p>
                    </div>
                    <% if (dbConnected && profesionales && profesionales.length) { %>
                        <p class="text-sm text-muni-muted"><span class="font-semibold tabular-nums text-muni-ink"><%= profesionales.length %></span> perfiles publicados</p>
                    <% } %>
                </div>

                <% if (!dbConnected) { %>
                    <div class="border-y border-red-200 bg-red-50 px-5 py-5 text-sm leading-6 text-red-950" role="alert">
                        <h3 class="font-semibold">No pudimos consultar el directorio.</h3>
                        <p class="mt-1">Revisa la conexión con Supabase y vuelve a cargar esta página. La cartelera pública sigue disponible.</p>
                        <a href="/personal" class="mt-3 inline-flex font-semibold underline underline-offset-4">Reintentar</a>
                    </div>
                <% } else if (!profesionales || profesionales.length === 0) { %>
                    <div class="border-y border-black/15 py-9" role="status">
                        <h3 class="text-xl font-semibold tracking-[-0.035em]">Aún no hay perfiles publicados</h3>
                        <p class="mt-2 max-w-2xl text-sm leading-6 text-muni-muted">Cuando el directorio tenga registros en Supabase, aparecerán aquí. Mientras tanto, puedes consultar las actividades y sus datos de contacto en la cartelera.</p>
                        <a href="/event" class="mt-5 inline-flex items-center gap-2 border-b border-muni-red pb-1 text-sm font-semibold hover:text-muni-red-dark">
                            Ir a la cartelera
                            <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
                        </a>
                    </div>
                <% } else { %>
                    <div class="border-t border-black/15">
                        <% profesionales.forEach((profesional) => { %>
                            <article class="grid gap-2 border-b border-black/10 py-5 sm:grid-cols-[minmax(14rem,0.8fr)_1.2fr] sm:items-center sm:gap-8 sm:py-6">
                                <div>
                                    <h3 class="text-lg font-semibold tracking-[-0.03em]"><%= profesional.nombre %></h3>
                                    <p class="mt-1 text-sm text-muni-red-dark"><%= profesional.profesion || 'Profesional municipal' %></p>
                                </div>
                                <div class="text-sm text-muni-muted">
                                    <% if (profesional.email) { %>
                                        <a href="mailto:<%= profesional.email %>" class="break-all underline decoration-black/20 underline-offset-4 hover:text-muni-red-dark"><%= profesional.email %></a>
                                    <% } else { %>
                                        <span>Correo de contacto no publicado</span>
                                    <% } %>
                                </div>
                            </article>
                        <% }) %>
                    </div>
                <% } %>
            </div>
        </section>

        <section class="bg-muni-soft px-4 py-12 md:px-7 md:py-16" aria-labelledby="equipo-contacto">
            <div class="mx-auto flex max-w-[1280px] flex-col gap-5 border-t border-black/10 pt-8 sm:flex-row sm:items-center sm:justify-between">
                <div>
                    <h2 id="equipo-contacto" class="text-2xl font-semibold tracking-[-0.04em] sm:text-3xl">¿Necesitas orientación sobre una actividad?</h2>
                    <p class="mt-2 text-sm leading-6 text-muni-muted">Comunícate con la coordinación municipal para consultas sobre talleres y recintos.</p>
                </div>
                <a href="/contact" class="inline-flex min-h-12 w-fit shrink-0 items-center gap-3 rounded-full bg-muni-red-dark px-6 text-sm font-semibold text-white transition-colors hover:bg-red-800">
                    Ver canales de atención
                    <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
                </a>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
