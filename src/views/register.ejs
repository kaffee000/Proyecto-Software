<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head') %>
    <title><%= title %></title>
</head>
<body class="bg-white text-slate-900 font-sans antialiased min-h-screen">
    <div class="min-h-screen grid grid-cols-1 lg:grid-cols-12">
        <!-- Columna Visual Editorial (5 cols en desktop con foto real de Talca) -->
        <div class="hidden lg:flex lg:col-span-5 relative overflow-hidden bg-slate-950 flex-col justify-between p-12 text-white">
            <img src="/images/actividad baile en piscina.jpeg" alt="Actividades recreativas en Talca" class="absolute inset-0 w-full h-full object-cover opacity-40">
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/65 to-slate-950/30"></div>

            <!-- Marca Superior con Logo Prominente -->
            <div class="relative z-10">
                <a href="/" class="flex items-center gap-4 group">
                    <img src="/images/logo-muni.png" alt="Emblema Municipalidad de Talca" class="w-14 h-14 object-contain shrink-0" width="56" height="56">
                    <div>
                        <span class="block text-xl font-black text-white tracking-tight leading-tight">Muni Sport</span>
                        <span class="block text-xs font-semibold text-slate-300 uppercase tracking-wider">Municipalidad de Talca</span>
                    </div>
                </a>
            </div>

            <!-- Mensaje Cívico Inferior -->
            <div class="relative z-10 max-w-md">
                <blockquote class="text-lg font-medium text-slate-200 leading-relaxed mb-4">
                    “Únete a la red deportiva municipal y mantente informado de los nuevos cupos y talleres en tu sector.”
                </blockquote>
                <p class="text-xs font-semibold text-slate-400">
                    Comunidad y Deportes • Talca Activa
                </p>
            </div>
        </div>

        <!-- Columna del Formulario (7 cols en desktop) -->
        <div class="lg:col-span-7 flex flex-col justify-between p-6 sm:p-12 lg:p-16 max-w-xl mx-auto w-full min-h-screen">
            <!-- Enlace Volver -->
            <div class="flex items-center justify-between mb-8">
                <a href="/" class="inline-flex items-center gap-2 text-xs font-bold text-slate-500 hover:text-slate-900 transition">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="19" y1="12" x2="5" y2="12"></line>
                        <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                    <span>Volver a la cartelera</span>
                </a>

                <!-- Logo visible en móvil -->
                <div class="lg:hidden flex items-center gap-2">
                    <img src="/images/logo-muni.png" alt="Emblema Municipalidad de Talca" class="w-10 h-10 object-contain">
                </div>
            </div>

            <!-- Formulario Central -->
            <div class="my-auto">
                <div class="mb-8">
                    <!-- Logo grande en desktop -->
                    <div class="hidden lg:block mb-4">
                        <img src="/images/logo-muni.png" alt="Emblema Municipalidad de Talca" class="w-16 h-16 object-contain" width="64" height="64">
                    </div>
                    <!-- Título limpio sin píldoras/eyebrows -->
                    <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight mb-2">
                        Crear Cuenta Ciudadana
                    </h1>
                    <p class="text-sm text-slate-600 leading-relaxed">
                        Regístrate para recibir notificaciones sobre nuevos talleres deportivos en Talca.
                    </p>
                </div>

                <form class="space-y-4" onsubmit="event.preventDefault(); document.getElementById('regNotice').classList.remove('hidden');">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label for="regNombre" class="block text-xs font-bold text-slate-800 mb-1.5 uppercase tracking-wide">
                                Nombre y Apellido
                            </label>
                            <input type="text" id="regNombre" class="w-full px-4 py-3 rounded-xl border border-slate-300 text-slate-900 text-sm focus:outline-none focus:border-red-600 focus:ring-4 focus:ring-red-600/15 transition shadow-sm" placeholder="Ej: Carlos Silva" required autocomplete="name">
                        </div>

                        <div>
                            <label for="regRun" class="block text-xs font-bold text-slate-800 mb-1.5 uppercase tracking-wide">
                                R.U.N.
                            </label>
                            <input type="text" id="regRun" class="w-full px-4 py-3 rounded-xl border border-slate-300 text-slate-900 text-sm focus:outline-none focus:border-red-600 focus:ring-4 focus:ring-red-600/15 transition shadow-sm" placeholder="12.345.678-9" required>
                        </div>
                    </div>

                    <div>
                        <label for="regEmail" class="block text-xs font-bold text-slate-800 mb-1.5 uppercase tracking-wide">
                            Correo Electrónico
                        </label>
                        <input type="email" id="regEmail" class="w-full px-4 py-3 rounded-xl border border-slate-300 text-slate-900 text-sm focus:outline-none focus:border-red-600 focus:ring-4 focus:ring-red-600/15 transition shadow-sm" placeholder="ejemplo@correo.cl" required autocomplete="email">
                    </div>

                    <div>
                        <label for="regSector" class="block text-xs font-bold text-slate-800 mb-1.5 uppercase tracking-wide">
                            Sector o Barrio en Talca
                        </label>
                        <input type="text" id="regSector" class="w-full px-4 py-3 rounded-xl border border-slate-300 text-slate-900 text-sm focus:outline-none focus:border-red-600 focus:ring-4 focus:ring-red-600/15 transition shadow-sm" placeholder="Ej: La Florida, Carlos Trupp, Centro">
                    </div>

                    <div>
                        <label for="regPassword" class="block text-xs font-bold text-slate-800 mb-1.5 uppercase tracking-wide">
                            Crear Contraseña
                        </label>
                        <input type="password" id="regPassword" class="w-full px-4 py-3 rounded-xl border border-slate-300 text-slate-900 text-sm focus:outline-none focus:border-red-600 focus:ring-4 focus:ring-red-600/15 transition shadow-sm" placeholder="Mínimo 8 caracteres" required autocomplete="new-password">
                    </div>

                    <button type="submit" class="w-full py-3.5 px-6 rounded-xl bg-red-600 hover:bg-red-700 active:bg-red-800 text-white font-bold text-base shadow-sm transition flex items-center justify-center gap-2 mt-2">
                        <span>Completar registro</span>
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                    </button>

                    <div id="regNotice" class="hidden p-4 rounded-xl bg-amber-50 border border-amber-200 text-amber-800 text-xs font-medium leading-relaxed" role="status">
                        Módulo de registro en fase demostrativa de diseño. No se almacenan datos personales en esta etapa.
                    </div>
                </form>

                <div class="mt-8 pt-6 border-t border-slate-200 text-center">
                    <p class="text-sm text-slate-600">
                        ¿Ya tienes una cuenta? 
                        <a href="/login" class="text-red-600 font-bold hover:underline">Inicia sesión</a>
                    </p>
                </div>
            </div>

            <!-- Footer Cívico Inferior -->
            <div class="pt-8 text-xs text-slate-400 text-center">
                Muni Sport Talca • Ilustre Municipalidad de Talca
            </div>
        </div>
    </div>
</body>
</html>