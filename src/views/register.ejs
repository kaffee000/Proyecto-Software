<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head') %>
    <title><%= title %></title>
</head>
<body class="min-h-screen bg-white font-sans text-muni-ink antialiased">
    <%- include('partials/navigation') %>

    <main id="contenido-principal" class="flex flex-1 items-center px-4 py-12 md:px-7 md:py-16">
        <section class="mx-auto w-full max-w-[760px] rounded-3xl border border-black/10 bg-white p-6 shadow-[0_24px_80px_-48px_rgba(25,25,25,0.25)] sm:p-10 lg:p-12" aria-labelledby="register-heading">
            <nav class="mb-7 flex items-center gap-2 text-xs font-medium text-muni-muted" aria-label="Ruta de navegación">
                <a href="/" class="hover:text-muni-red-dark">Inicio</a>
                <span aria-hidden="true">/</span>
                <a href="/login" class="hover:text-muni-red-dark">Acceso vecinal</a>
                <span aria-hidden="true">/</span>
                <span aria-current="page" class="text-muni-ink">Crear cuenta</span>
            </nav>
            <h1 id="register-heading" class="text-3xl font-semibold leading-[1.03] tracking-[-0.04em] sm:text-4xl">Únete a Muni Sport.</h1>
            <p class="mt-3 max-w-xl text-sm leading-6 text-muni-muted">Crea tu cuenta para guardar talleres y encuentros deportivos de Talca.</p>

            <% if (errors && errors.length) { %>
                <div class="mt-6 border-y border-red-200 bg-red-50 px-4 py-4 text-sm leading-6 text-red-900" role="alert">
                    <ul class="list-inside list-disc space-y-1"><% errors.forEach((message) => { %><li><%= message %></li><% }) %></ul>
                </div>
            <% } %>

            <form action="/register" method="post" class="mt-7 grid gap-x-6 gap-y-5 sm:grid-cols-2">
                <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
                <div class="sm:col-span-2">
                    <label for="fullName" class="form-label">Nombre</label>
                    <input id="fullName" name="fullName" type="text" class="form-control" value="<%= values.fullName || '' %>" placeholder="Tu nombre y apellido" minlength="2" maxlength="80" required autocomplete="name" autofocus>
                </div>
                <div class="sm:col-span-2">
                    <label for="email" class="form-label">Correo electrónico</label>
                    <input id="email" name="email" type="email" class="form-control" value="<%= values.email || '' %>" placeholder="tu@correo.cl" maxlength="254" required autocomplete="email">
                </div>
                <div class="sm:col-span-2">
                    <label for="avatarUrl" class="form-label">Foto de perfil <span class="font-normal text-muni-muted">(opcional)</span></label>
                    <input id="avatarUrl" name="avatarUrl" type="url" class="form-control" value="<%= values.avatarUrl || '' %>" placeholder="https://..." autocomplete="url">
                    <p class="form-hint">Agrega una URL segura de una foto. Si la dejas vacía, mostraremos tus iniciales.</p>
                </div>
                <div>
                    <label for="password" class="form-label">Contraseña</label>
                    <input id="password" name="password" type="password" class="form-control" placeholder="Mínimo 8 caracteres" minlength="8" maxlength="72" required autocomplete="new-password">
                </div>
                <div>
                    <label for="passwordConfirmation" class="form-label">Repite la contraseña</label>
                    <input id="passwordConfirmation" name="passwordConfirmation" type="password" class="form-control" placeholder="Vuelve a escribirla" minlength="8" maxlength="72" required autocomplete="new-password">
                </div>
                <div class="sm:col-span-2">
                    <button type="submit" class="inline-flex min-h-12 w-full items-center justify-center rounded-full bg-muni-red-dark px-6 text-sm font-semibold text-white transition-colors hover:bg-red-800">Crear cuenta vecinal</button>
                </div>
            </form>

            <p class="mt-6 text-center text-sm text-muni-muted">¿Ya tienes cuenta? <a href="/login" class="font-semibold text-muni-ink underline decoration-muni-red underline-offset-4 hover:text-muni-red-dark">Iniciar sesión</a></p>
        </section>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
