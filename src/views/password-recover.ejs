<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head') %>
    <title><%= title %></title>
</head>
<body class="min-h-screen bg-white font-sans text-muni-ink antialiased">
    <%- include('partials/navigation') %>

    <main id="contenido-principal" class="flex flex-1 items-center px-4 py-12 md:px-7 md:py-16">
        <section class="mx-auto w-full max-w-[620px] rounded-3xl border border-black/10 bg-white p-6 sm:p-10 lg:p-12" aria-labelledby="recover-heading">
            <nav class="mb-7 flex items-center gap-2 text-xs font-medium text-muni-muted" aria-label="Ruta de navegación">
                <a href="/" class="hover:text-muni-red-dark">Inicio</a>
                <span aria-hidden="true">/</span>
                <a href="/login" class="hover:text-muni-red-dark">Acceso vecinal</a>
                <span aria-hidden="true">/</span>
                <span aria-current="page" class="text-muni-ink">Recuperar contraseña</span>
            </nav>

            <h1 id="recover-heading" class="text-3xl font-semibold leading-[1.03] tracking-[-0.04em] sm:text-4xl">Recupera tu acceso.</h1>
            <p class="mt-3 max-w-xl text-sm leading-6 text-muni-muted">Escribe el correo de tu cuenta vecinal y te enviaremos un enlace para crear una contraseña nueva.</p>

            <% if (notice) { %>
                <div class="mt-6 border-y border-emerald-300 bg-emerald-50 px-4 py-3 text-sm leading-6 text-emerald-950" role="status"><%= notice %></div>
            <% } %>
            <% if (error) { %>
                <div class="mt-6 border-y border-red-200 bg-red-50 px-4 py-3 text-sm leading-6 text-red-900" role="alert"><%= error %></div>
            <% } %>

            <form action="/password/recuperar" method="post" class="mt-7 space-y-5">
                <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
                <div>
                    <label for="email" class="form-label">Correo electrónico</label>
                    <input id="email" name="email" type="email" class="form-control" value="<%= email || '' %>" placeholder="tu@correo.cl" maxlength="254" required autocomplete="email" autofocus>
                </div>
                <button type="submit" class="inline-flex min-h-12 w-full items-center justify-center rounded-full bg-muni-red-dark px-6 text-sm font-semibold text-white transition-colors hover:bg-red-800">Enviar enlace de recuperación</button>
            </form>

            <p class="mt-6 border-t border-black/10 pt-5 text-center text-sm text-muni-muted">¿Recordaste tu contraseña? <a href="/login" class="font-semibold text-muni-ink underline decoration-muni-red underline-offset-4 hover:text-muni-red-dark">Volver al acceso</a></p>
        </section>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
