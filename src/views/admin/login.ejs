<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
    <title><%= title %></title>
</head>
<body class="min-h-screen bg-white font-sans text-muni-ink antialiased">
    <%- include('../partials/navigation') %>
    <main id="contenido-principal" class="flex flex-1 items-center px-4 py-14 md:px-7 md:py-20">
        <div class="mx-auto grid w-full max-w-[1040px] overflow-hidden rounded-[24px] border border-black/10 lg:grid-cols-[0.9fr_1.1fr]">
            <div class="relative hidden min-h-[540px] overflow-hidden bg-muni-ink lg:block">
                <img src="/images/portada.jpg" alt="" class="absolute inset-0 h-full w-full object-cover opacity-65" width="900" height="1200">
                <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/25 to-black/10"></div>
                <div class="relative flex h-full flex-col justify-between p-10 text-white">
                    <p class="max-w-[12ch] text-4xl font-medium leading-[1.05] tracking-[-0.04em]">Una cartelera viva empieza con información clara.</p>
                    <p class="max-w-sm text-sm leading-6 text-white/90">Espacio de gestión para publicar y mantener las actividades municipales de Talca.</p>
                </div>
            </div>

            <div class="flex min-h-[540px] items-center px-6 py-10 sm:px-10 lg:px-14">
                <div class="mx-auto w-full max-w-md">
                    <a href="/" class="inline-flex items-center gap-2 text-sm font-medium text-muni-muted hover:text-muni-red-dark">
                        <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5m7 7-7-7 7-7"></path></svg>
                        Volver a la cartelera
                    </a>
                    <h1 class="mt-10 text-3xl font-semibold tracking-[-0.04em] sm:text-4xl">Acceso organizador</h1>
                    <p class="mt-3 text-sm leading-6 text-muni-muted">Ingresa con la cuenta autorizada para gestionar actividades y talleres.</p>

                    <% if (expired) { %>
                        <div class="mt-6 border-y border-amber-300 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-950" role="status">
                            Tu sesión terminó. Vuelve a ingresar para continuar.
                        </div>
                    <% } %>

                    <% if (error) { %>
                        <div class="mt-6 border-y border-red-200 bg-red-50 px-4 py-3 text-sm leading-6 text-red-900" role="alert"><%= error %></div>
                    <% } %>

                    <form method="post" action="/admin/login" class="mt-8 space-y-5">
                        <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
                        <input type="hidden" name="next" value="<%= next %>">
                        <div>
                            <label for="email" class="form-label">Correo electrónico</label>
                            <input id="email" name="email" type="email" class="form-control" placeholder="organizacion@talca.cl" required autocomplete="username" autofocus>
                        </div>
                        <div>
                            <label for="password" class="form-label">Contraseña</label>
                            <input id="password" name="password" type="password" class="form-control" placeholder="Tu contraseña" required autocomplete="current-password">
                        </div>
                        <button type="submit" class="inline-flex min-h-12 w-full items-center justify-center rounded-full bg-muni-red-dark px-6 text-sm font-semibold text-white transition-colors hover:bg-red-800">
                            Ingresar al panel
                        </button>
                    </form>

                    <p class="mt-6 border-t border-black/10 pt-5 text-xs leading-5 text-muni-muted">El acceso está limitado a cuentas habilitadas por la Municipalidad en Supabase.</p>
                </div>
            </div>
        </div>
    </main>
    <%- include('../partials/footer') %>
</body>
</html>
