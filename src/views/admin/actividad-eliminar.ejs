<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
    <title><%= title %></title>
</head>
<body class="min-h-screen bg-white font-sans text-muni-ink antialiased">
    <%- include('../partials/navigation') %>
    <main id="contenido-principal" class="flex-1 px-4 py-12 md:px-7 md:py-20">
        <div class="mx-auto max-w-[760px]">
            <nav class="mb-6 flex items-center gap-2 text-xs font-medium text-muni-muted" aria-label="Ruta de navegación">
                <a href="/admin/actividades" class="hover:text-muni-red-dark">Gestión de actividades</a><span aria-hidden="true">/</span>
                <span aria-current="page" class="text-muni-ink">Eliminar actividad</span>
            </nav>
            <div class="border-y border-red-300 py-8 sm:py-10">
                <h1 class="text-3xl font-semibold leading-tight tracking-[-0.04em] sm:text-4xl">¿Eliminar esta actividad?</h1>
                <p class="mt-3 max-w-xl text-sm leading-6 text-muni-muted">La actividad dejará de aparecer en la cartelera. Esta acción no se puede deshacer desde el panel.</p>

                <div class="mt-7 border-y border-black/10 py-5">
                    <h2 class="text-xl font-semibold tracking-[-0.03em]"><%= activity.nombre %></h2>
                    <p class="mt-2 text-sm text-muni-muted"><%= activity.lugar %></p>
                    <%
                        const fechaActividad = new Date(activity.fecha);
                        const fechaValida = !Number.isNaN(fechaActividad.getTime());
                        const fechaTexto = fechaValida
                            ? new Intl.DateTimeFormat("es-CL", { weekday: "long", day: "numeric", month: "long", year: "numeric", hour: "2-digit", minute: "2-digit", timeZone: "America/Santiago", hourCycle: "h23" }).format(fechaActividad)
                            : "Fecha por confirmar";
                    %>
                    <p class="mt-1 text-sm tabular-nums text-muni-muted"><%= fechaTexto %></p>
                </div>

                <form method="post" action="/admin/actividades/<%= activity.id %>/eliminar" class="mt-7 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
                    <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
                    <a href="/admin/actividades" class="inline-flex min-h-12 items-center justify-center rounded-full border border-black/20 px-6 text-sm font-semibold text-muni-ink hover:border-black/40">Conservar actividad</a>
                    <button type="submit" class="inline-flex min-h-12 items-center justify-center rounded-full bg-red-700 px-6 text-sm font-semibold text-white hover:bg-red-800">Eliminar definitivamente</button>
                </form>
            </div>
        </div>
    </main>
    <%- include('../partials/footer') %>
</body>
</html>
