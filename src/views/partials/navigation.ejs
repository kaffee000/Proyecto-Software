<a href="#contenido-principal" class="skip-link">Saltar al contenido principal</a>

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200 px-4 py-3.5 transition">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
        <!-- Logo y Marca (Logo prominente, sin píldoras en la cabecera) -->
        <a href="/" class="flex items-center gap-3.5 group" aria-label="Muni Sport Talca - Volver al inicio">
            <img src="/images/logo-muni.png" alt="Emblema Ilustre Municipalidad de Talca" class="w-12 h-12 object-contain shrink-0" width="48" height="48">
            <div class="flex flex-col">
                <span class="text-xl font-black text-slate-900 tracking-tight group-hover:text-red-600 transition leading-tight">Muni Sport</span>
                <span class="text-xs font-semibold text-slate-500 tracking-wider uppercase">Municipalidad de Talca</span>
            </div>
        </a>

        <!-- Enlaces Desktop -->
        <nav class="hidden md:flex items-center gap-1.5 text-sm font-semibold text-slate-700" aria-label="Navegación principal">
            <a href="/" class="px-3.5 py-2 rounded-xl hover:text-slate-900 hover:bg-slate-100 transition">Inicio</a>
            <a href="/event" class="px-3.5 py-2 rounded-xl hover:text-slate-900 hover:bg-slate-100 transition">Catálogo</a>
            <a href="/sport" class="px-3.5 py-2 rounded-xl hover:text-slate-900 hover:bg-slate-100 transition">Disciplinas</a>
            <a href="/personal" class="px-3.5 py-2 rounded-xl hover:text-slate-900 hover:bg-slate-100 transition">Profesionales</a>
            <a href="/contact" class="px-3.5 py-2 rounded-xl hover:text-slate-900 hover:bg-slate-100 transition">Contacto</a>
        </nav>

        <!-- Botón Acceso Vecinal -->
        <div class="hidden md:flex items-center gap-3">
            <a href="/login" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-bold text-white bg-red-600 hover:bg-red-700 active:bg-red-800 transition shadow-sm">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                </svg>
                <span>Acceso Vecinal</span>
            </a>
        </div>

        <!-- Botón Hamburguesa Móvil -->
        <button type="button" id="navToggle" class="md:hidden p-2.5 rounded-xl text-slate-700 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-red-600" aria-expanded="false" aria-controls="navMenu" aria-label="Abrir menú de navegación">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
        </button>
    </div>

    <!-- Menú Desplegable Móvil -->
    <div id="navMenu" class="hidden md:hidden border-t border-slate-100 mt-3 pt-3 flex flex-col gap-1 pb-2">
        <a href="/" class="px-4 py-2.5 rounded-xl text-sm font-semibold text-slate-800 hover:bg-slate-100 transition">Inicio</a>
        <a href="/event" class="px-4 py-2.5 rounded-xl text-sm font-semibold text-slate-800 hover:bg-slate-100 transition">Catálogo</a>
        <a href="/sport" class="px-4 py-2.5 rounded-xl text-sm font-semibold text-slate-800 hover:bg-slate-100 transition">Disciplinas</a>
        <a href="/personal" class="px-4 py-2.5 rounded-xl text-sm font-semibold text-slate-800 hover:bg-slate-100 transition">Profesionales</a>
        <a href="/contact" class="px-4 py-2.5 rounded-xl text-sm font-semibold text-slate-800 hover:bg-slate-100 transition">Contacto</a>
        <div class="pt-2 mt-1 border-t border-slate-100">
            <a href="/login" class="flex items-center justify-center gap-2 w-full py-2.5 rounded-xl text-sm font-bold text-white bg-red-600 hover:bg-red-700 active:bg-red-800 transition">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                </svg>
                <span>Acceso Vecinal</span>
            </a>
        </div>
    </div>
</header>

<script>
    (function() {
        const toggle = document.getElementById('navToggle');
        const menu = document.getElementById('navMenu');
        if (toggle && menu) {
            toggle.addEventListener('click', function() {
                const isHidden = menu.classList.contains('hidden');
                if (isHidden) {
                    menu.classList.remove('hidden');
                    toggle.setAttribute('aria-expanded', 'true');
                } else {
                    menu.classList.add('hidden');
                    toggle.setAttribute('aria-expanded', 'false');
                }
            });
        }
    })();
</script>