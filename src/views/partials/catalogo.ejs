<section class="max-w-7xl mx-auto px-4 py-12" id="catalogo-actividades" aria-labelledby="catalogo-heading">
    <!-- Encabezado y Filtros de Categorías -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8">
        <div>
            <h2 id="catalogo-heading" class="text-2xl md:text-3xl font-extrabold text-slate-900 tracking-tight mb-2">
                Cartelera de actividades disponibles
            </h2>
            <p class="text-sm md:text-base text-slate-600 max-w-2xl">
                Explora las convocatorias deportivas y formativas abiertas en Talca. Filtra por tu área de preferencia y asegura tu lugar.
            </p>
        </div>

        <!-- Filtros Táctiles -->
        <div class="flex flex-wrap gap-2" role="tablist" aria-label="Filtro de categorías">
            <a href="?categoria=todas" 
               class="px-4 py-2 rounded-xl text-sm font-bold transition shadow-sm <%= (!categoria || categoria.toLowerCase() === 'todas') ? 'bg-slate-900 text-white' : 'bg-white text-slate-700 border border-slate-200 hover:bg-slate-50' %>"
               role="tab"
               aria-selected="<%= (!categoria || categoria.toLowerCase() === 'todas') %>">
               Todas
            </a>
            <a href="?categoria=Deportes" 
               class="px-4 py-2 rounded-xl text-sm font-bold transition shadow-sm <%= (categoria && categoria.toLowerCase() === 'deportes') ? 'bg-red-600 text-white' : 'bg-white text-slate-700 border border-slate-200 hover:bg-slate-50' %>"
               role="tab"
               aria-selected="<%= (categoria && categoria.toLowerCase() === 'deportes') %>">
               Deportes
            </a>
            <a href="?categoria=Salud" 
               class="px-4 py-2 rounded-xl text-sm font-bold transition shadow-sm <%= (categoria && categoria.toLowerCase() === 'salud') ? 'bg-emerald-600 text-white' : 'bg-white text-slate-700 border border-slate-200 hover:bg-slate-50' %>"
               role="tab"
               aria-selected="<%= (categoria && categoria.toLowerCase() === 'salud') %>">
               Salud
            </a>
            <a href="?categoria=Sociales" 
               class="px-4 py-2 rounded-xl text-sm font-bold transition shadow-sm <%= (categoria && categoria.toLowerCase() === 'sociales') ? 'bg-sky-600 text-white' : 'bg-white text-slate-700 border border-slate-200 hover:bg-slate-50' %>"
               role="tab"
               aria-selected="<%= (categoria && categoria.toLowerCase() === 'sociales') %>">
               Sociales
            </a>
        </div>
    </div>

    <!-- Formulario Fallback (Accesibilidad y Testing) -->
    <form action="" method="GET" class="hidden">
        <label for="categoria" class="sr-only">Seleccionar categoría:</label>
        <select name="categoria" id="categoria" onchange="this.form.submit()">
            <option value="todas" <%= (!categoria || categoria.toLowerCase() === 'todas') ? 'selected' : '' %>>Todas las actividades</option>
            <option value="Deportes" <%= (categoria && categoria.toLowerCase() === 'deportes') ? 'selected' : '' %>>Deportes</option>
            <option value="Salud" <%= (categoria && categoria.toLowerCase() === 'salud') ? 'selected' : '' %>>Salud</option>
            <option value="Sociales" <%= (categoria && categoria.toLowerCase() === 'sociales') ? 'selected' : '' %>>Sociales</option>
        </select>
        <button type="submit">Filtrar</button>
    </form>

    <!-- Grilla de Actividades -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="listaActividades">
        <% if (!actividades || actividades.length === 0) { %>
            <!-- Estado vacío amigable (AC-04) -->
            <div class="col-span-full bg-white rounded-2xl border border-dashed border-slate-300 p-12 text-center max-w-lg mx-auto" role="status" aria-live="polite">
                <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center">
                    <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                </div>
                <h3 class="text-lg font-bold text-slate-900 mb-2">No hay actividades para esta categoría</h3>
                <p class="text-sm text-slate-600 mb-6">
                    No registramos convocatorias abiertas en la categoría seleccionada por el momento. Puedes consultar las demás alternativas de la comuna.
                </p>
                <a href="?categoria=todas" class="inline-flex px-5 py-2.5 rounded-xl text-sm font-bold text-white bg-red-600 hover:bg-red-700 transition">
                    Mostrar todas las actividades
                </a>
            </div>
        <% } else { %>
            <% actividades.forEach((actividad) => { 
                let badgeBg = "bg-red-600 text-white";
                if (actividad.categoria && actividad.categoria.toLowerCase() === "salud") badgeBg = "bg-emerald-600 text-white";
                if (actividad.categoria && actividad.categoria.toLowerCase() === "sociales") badgeBg = "bg-sky-600 text-white";

                let fechaFormateada = "";
                try {
                    const f = new Date(actividad.fecha);
                    fechaFormateada = f.toLocaleDateString("es-CL", { 
                        weekday: 'short', 
                        day: 'numeric', 
                        month: 'short',
                        hour: '2-digit',
                        minute: '2-digit'
                    });
                } catch(e) {
                    fechaFormateada = actividad.fecha || "Fecha por confirmar";
                }
            %>
                <article class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-200 flex flex-col justify-between" data-categoria="<%= actividad.categoria %>">
                    <% if (actividad.imagen) { %>
                        <div class="relative h-48 w-full bg-slate-100 overflow-hidden">
                            <img src="<%= actividad.imagen %>" alt="<%= actividad.nombre %>" class="w-full h-full object-cover" loading="lazy" width="380" height="200">
                            <span class="absolute top-3 left-3 px-3 py-1 text-xs font-bold rounded-full uppercase tracking-wider <%= badgeBg %> shadow-sm">
                                <%= actividad.categoria %>
                            </span>
                        </div>
                    <% } %>

                    <div class="p-5 flex flex-col flex-grow justify-between gap-4">
                        <div>
                            <div class="flex items-center justify-between gap-2 mb-2">
                                <% if (!actividad.imagen) { %>
                                    <span class="px-2.5 py-0.5 text-xs font-bold rounded-full uppercase tracking-wide <%= badgeBg %>">
                                        <%= actividad.categoria %>
                                    </span>
                                <% } %>
                                <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-600 ml-auto">
                                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                                    <%= actividad.estado === 'activo' ? 'Cupos disponibles' : actividad.estado %>
                                </span>
                            </div>

                            <h3 class="text-base font-extrabold text-slate-900 leading-snug mb-1.5 line-clamp-2">
                                <%= actividad.nombre %>
                            </h3>
                            <p class="text-xs text-slate-600 line-clamp-2 leading-relaxed">
                                <%= actividad.descripcion %>
                            </p>
                        </div>

                        <div class="space-y-2 pt-3 border-t border-slate-100 text-xs text-slate-600">
                            <div class="flex items-center gap-2 text-slate-700 font-medium">
                                <svg class="w-4 h-4 text-slate-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                    <line x1="16" y1="2" x2="16" y2="6"></line>
                                    <line x1="8" y1="2" x2="8" y2="6"></line>
                                    <line x1="3" y1="10" x2="21" y2="10"></line>
                                </svg>
                                <span><%= fechaFormateada %></span>
                            </div>

                            <% if (actividad.lugar) { %>
                            <div class="flex items-center gap-2 text-slate-600">
                                <svg class="w-4 h-4 text-slate-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                    <circle cx="12" cy="10" r="3"></circle>
                                </svg>
                                <span class="truncate"><%= actividad.lugar %></span>
                            </div>
                            <% } %>

                            <% if (actividad.cupos) { %>
                            <div class="flex items-center gap-2 font-bold text-emerald-700">
                                <svg class="w-4 h-4 text-emerald-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="9" cy="7" r="4"></circle>
                                </svg>
                                <span><%= actividad.cupos %></span>
                            </div>
                            <% } %>
                        </div>

                        <div class="pt-2">
                            <a href="/pagos" class="w-full py-2.5 px-4 bg-red-600 hover:bg-red-700 active:bg-red-800 text-white font-bold text-sm rounded-xl text-center transition flex items-center justify-center gap-2 shadow-sm">
                                <span>Inscribirme al taller</span>
                                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                    <polyline points="12 5 19 12 12 19"></polyline>
                                </svg>
                            </a>
                        </div>
                    </div>
                </article>
            <% }) %>
        <% } %>
    </div>
</section>

<script>
(function() {
    const catalogoSection = document.getElementById('catalogo-actividades');
    if (!catalogoSection) return;

    // Delegación de eventos para capturar los clics en los botones de filtro de categorías
    catalogoSection.addEventListener('click', async (e) => {
        const link = e.target.closest('a[role="tab"], a[href*="categoria="]');
        if (!link || !catalogoSection.contains(link)) return;

        const href = link.getAttribute('href');
        if (!href || href.startsWith('#') || href.startsWith('/pagos') || href.startsWith('/contact')) return;

        e.preventDefault();

        // Evitar recargar si ya está seleccionada la categoría actual
        if (link.getAttribute('aria-selected') === 'true') return;

        try {
            const lista = document.getElementById('listaActividades');
            if (lista) {
                lista.style.transition = 'opacity 0.15s ease';
                lista.style.opacity = '0.4';
            }

            const response = await fetch(href, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
            if (!response.ok) throw new Error('Respuesta no exitosa al cargar categoría');

            const html = await response.text();
            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');
            const nuevoCatalogo = doc.getElementById('catalogo-actividades');

            if (nuevoCatalogo) {
                catalogoSection.innerHTML = nuevoCatalogo.innerHTML;
            }

            window.history.pushState({ path: href }, '', href);
        } catch (error) {
            console.error('Error al filtrar dinámicamente:', error);
            window.location.href = href;
        }
    });

    if (!window.__catalogoPopstateAttached) {
        window.__catalogoPopstateAttached = true;
        window.addEventListener('popstate', async () => {
            try {
                const response = await fetch(window.location.href, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                if (!response.ok) return window.location.reload();

                const html = await response.text();
                const doc = new DOMParser().parseFromString(html, 'text/html');
                const nuevoCatalogo = doc.getElementById('catalogo-actividades');
                const currentCatalogo = document.getElementById('catalogo-actividades');
                if (nuevoCatalogo && currentCatalogo) {
                    currentCatalogo.innerHTML = nuevoCatalogo.innerHTML;
                }
            } catch (e) {
                window.location.reload();
            }
        });
    }
})();
</script>
