<%
    const esInicio = catalogoMode === "home";
    const esFavoritos = catalogoMode === "favorites";
    const rutaCatalogo = esInicio ? "/" : "/event";
    const filtroActivo = typeof categoria === "string" ? categoria.toLowerCase() : "todas";
    const actividadesDisponibles = Array.isArray(actividades) ? actividades : [];
    const actividadesVisibles = esInicio ? actividadesDisponibles.slice(0, 4) : actividadesDisponibles;
    const idsFavoritos = Array.isArray(favoriteIds) ? favoriteIds : [];
    const filtrosCatalogo = [
        { id: "todas", label: "Todas" },
        { id: "deportes", label: "Deportes" },
        { id: "salud", label: "Salud" },
        { id: "sociales", label: "Sociales" }
    ];
    const nombreEstado = {
        activo: "Activa",
        pausado: "Pausada",
        finalizado: "Finalizada",
        cancelado: "Cancelada"
    };
    const claseEstado = {
        activo: "bg-red-50 text-red-800",
        pausado: "bg-amber-50 text-amber-900",
        finalizado: "bg-stone-100 text-stone-700",
        cancelado: "bg-stone-100 text-stone-700"
    };
%>

<section id="catalogo-actividades" data-mode="<%= esFavoritos ? 'favorites' : (esInicio ? 'home' : 'full') %>" class="scroll-mt-8 px-4 md:px-7 <%= esInicio ? 'py-16 md:py-24' : 'pb-16 pt-8 md:pb-24 md:pt-10' %>" aria-labelledby="catalogo-heading">
    <div class="mx-auto max-w-[1280px]">
        <% if (esInicio) { %>
            <div class="mb-9 flex flex-col gap-5 sm:mb-12 sm:flex-row sm:items-end sm:justify-between">
                <div class="max-w-2xl">
                    <h2 id="catalogo-heading" class="text-3xl font-semibold leading-tight tracking-[-0.04em] text-muni-ink sm:text-4xl">Lo que viene en Talca</h2>
                    <p class="mt-3 max-w-xl text-base leading-7 text-muni-muted">Fechas, lugares y actividades para encontrar tu próximo espacio de movimiento.</p>
                </div>
                <a href="/event" class="inline-flex w-fit items-center gap-2 border-b border-muni-red pb-1 text-sm font-semibold text-muni-ink transition-colors hover:text-muni-red-dark">
                    Ver toda la cartelera
                    <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14M13 6l6 6-6 6"></path>
                    </svg>
                </a>
            </div>
        <% } %>

        <% if (!esFavoritos) { %>
            <div class="mb-6 flex flex-wrap gap-2" aria-label="Filtrar actividades por categoría">
                <% filtrosCatalogo.forEach((filtro) => { %>
                    <%
                        const seleccionado = filtroActivo === filtro.id || (filtro.id === "todas" && filtroActivo === "todas");
                        const parametrosFiltro = new URLSearchParams();
                        if (filtro.id !== "todas") parametrosFiltro.set("categoria", filtro.id);
                        if (buscar) parametrosFiltro.set("buscar", buscar);
                        const destinoFiltro = `${rutaCatalogo}${parametrosFiltro.size ? `?${parametrosFiltro.toString()}` : ""}`;
                    %>
                    <a href="<%= destinoFiltro %>" data-catalog-filter class="rounded-full border px-4 py-2 text-[13px] font-medium transition-colors <%= seleccionado ? 'border-muni-ink bg-muni-ink text-white' : 'border-black/15 bg-white text-muni-ink hover:border-muni-red hover:text-muni-red-dark' %>" <% if (seleccionado) { %>aria-current="page"<% } %>>
                        <%= filtro.label %>
                    </a>
                <% }) %>
            </div>
        <% } %>

        <% if (typeof favoritoError !== "undefined" && favoritoError) { %>
            <div class="mb-5 border-y border-red-200 bg-red-50 px-4 py-3 text-sm text-red-900" role="alert">No se pudo actualizar el favorito. Revisa que la migración de favoritos esté aplicada en Supabase e inténtalo otra vez.</div>
        <% } %>

        <% if (catalogoError) { %>
            <div class="border-y border-red-200 bg-red-50 px-5 py-5 text-sm text-red-900" role="alert">
                <p class="font-semibold">No pudimos consultar la cartelera ahora.</p>
                <p class="mt-1"><%= esFavoritos ? "Comprueba que la migración de favoritos esté aplicada en Supabase y vuelve a intentarlo." : "Revisa la conexión con Supabase y que estén aplicadas las migraciones del proyecto." %></p>
                <a href="<%= reintentarUrl %>" class="mt-3 inline-flex font-semibold underline underline-offset-4">Reintentar</a>
            </div>
        <% } else if (actividadesVisibles.length === 0) { %>
            <div class="border-y border-black/10 py-12">
                <h3 class="text-xl font-semibold tracking-[-0.03em] text-muni-ink"><%= esFavoritos ? "Todavía no guardas actividades" : buscar ? "No encontramos actividades con esa búsqueda" : "Todavía no hay actividades en esta categoría" %></h3>
                <p class="mt-2 max-w-xl text-sm leading-6 text-muni-muted"><%= esFavoritos ? "Marca el corazón de una actividad para tenerla a mano aquí." : "Prueba con otra palabra o categoría, o vuelve a revisar la cartelera más adelante." %></p>
                <% if (!esFavoritos && (filtroActivo !== "todas" || buscar)) { %>
                    <a href="<%= rutaCatalogo %>" data-catalog-filter class="mt-5 inline-flex border-b border-muni-red pb-1 text-sm font-semibold text-muni-ink hover:text-muni-red-dark">Ver todas las actividades</a>
                <% } %>
            </div>
        <% } else { %>
            <div class="border-t border-black/15">
                <% actividadesVisibles.forEach((actividad, index) => { %>
                    <%
                        const fechaActividad = new Date(actividad.fecha);
                        const fechaValida = !Number.isNaN(fechaActividad.getTime());
                        const partesFecha = fechaValida ? new Intl.DateTimeFormat("es-CL", {
                            weekday: "short", day: "2-digit", month: "short", timeZone: "America/Santiago"
                        }).formatToParts(fechaActividad) : [];
                        const parteFecha = (tipo) => partesFecha.find((parte) => parte.type === tipo)?.value || "";
                        const fechaHora = fechaValida ? new Intl.DateTimeFormat("es-CL", {
                            hour: "2-digit", minute: "2-digit", timeZone: "America/Santiago", hourCycle: "h23"
                        }).format(fechaActividad) : "Hora por confirmar";
                        const estado = actividad.estado || "activo";
                        const imagenActividad = typeof actividad.imagen === "string" ? actividad.imagen.trim() : "";
                        const esFavorita = idsFavoritos.includes(actividad.id);
                        const cuposDisponibles = Math.max(0, Number(actividad.cupos_totales || 0) - Number(actividad.cupos_ocupados || 0));
                        const inscripcionAbierta = estado === "activo" && cuposDisponibles > 0;
                    %>
                    <article id="actividad-<%= actividad.id %>" class="grid gap-4 border-b border-black/10 py-6 sm:grid-cols-[5.75rem_minmax(0,1.45fr)_minmax(10rem,0.85fr)_8rem_5.5rem] sm:items-center sm:gap-6 sm:py-7" data-categoria="<%= actividad.categoria %>">
                        <time class="flex items-baseline gap-2 tabular-nums sm:block" datetime="<%= fechaValida ? fechaActividad.toISOString() : '' %>">
                            <span class="text-3xl font-semibold leading-none tracking-[-0.04em] text-muni-ink"><%= fechaValida ? parteFecha("day") : "—" %></span>
                            <span class="text-xs font-semibold uppercase tracking-[0.08em] text-muni-red-dark"><%= fechaValida ? parteFecha("month").replace(".", "") : "Por definir" %></span>
                            <span class="sm:mt-1 sm:block sm:text-[11px] sm:font-medium sm:uppercase sm:tracking-[0.08em] sm:text-muni-muted"><%= fechaValida ? parteFecha("weekday").replace(".", "") : "" %></span>
                        </time>

                        <div class="grid min-w-0 grid-cols-[5rem_minmax(0,1fr)] items-center gap-3 sm:items-start sm:gap-4">
                            <% if (imagenActividad) { %>
                                <img src="<%= imagenActividad %>" alt="" class="h-16 w-20 rounded-lg object-cover sm:h-20 sm:w-24" width="96" height="80" loading="lazy">
                            <% } else { %>
                                <div aria-hidden="true" class="flex h-16 w-20 items-center justify-center rounded-lg bg-muni-soft text-muni-red-dark sm:h-20 sm:w-24">
                                    <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M3 12h4l2.5-7L14 19l2.5-7H21"></path>
                                    </svg>
                                </div>
                            <% } %>
                            <div class="min-w-0">
                                <div class="mb-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] font-semibold uppercase tracking-[0.11em] text-muni-muted">
                                    <span><%= actividad.categoria %></span>
                                    <span aria-hidden="true" class="h-1 w-1 rounded-full bg-muni-red-dark"></span>
                                    <span class="tabular-nums"><%= fechaHora %></span>
                                </div>
                                <h3 class="text-lg font-semibold leading-snug tracking-[-0.025em] text-muni-ink sm:text-xl"><%= actividad.nombre %></h3>
                                <p class="mt-1.5 max-w-[62ch] text-sm leading-6 text-muni-muted"><%= actividad.descripcion %></p>
                            </div>
                        </div>

                        <div class="min-w-0 text-sm leading-6 text-muni-muted">
                            <div class="flex items-start gap-2">
                                <svg aria-hidden="true" class="mt-1 h-4 w-4 shrink-0 text-muni-red-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"></path><circle cx="12" cy="10" r="2.5"></circle>
                                </svg>
                                <span><%= actividad.lugar || "Recinto por confirmar" %></span>
                            </div>
                            <p class="mt-1 pl-6 text-xs <%= cuposDisponibles > 0 ? 'text-muni-muted' : 'font-medium text-red-800' %>"><%= cuposDisponibles === 1 ? "1 cupo disponible" : `${cuposDisponibles} cupos disponibles` %></p>
                        </div>

                        <span class="inline-flex w-fit items-center rounded-full px-3 py-1.5 text-xs font-semibold <%= claseEstado[estado] || 'bg-stone-100 text-stone-700' %>">
                            <%= nombreEstado[estado] || "Estado por confirmar" %>
                        </span>

                        <div class="flex items-center gap-2">
                            <% if (isResident) { %>
                                <form action="/favoritos/<%= actividad.id %>" method="post" data-favorite-form>
                                    <input type="hidden" name="csrfToken" value="<%= csrfToken || '' %>">
                                    <input type="hidden" name="action" value="<%= esFavorita ? 'remove' : 'add' %>">
                                    <input type="hidden" name="returnTo" value="<%= currentPath || '/event' %>">
                                    <button type="submit" data-favorite-button class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-black/15 text-muni-ink transition-colors hover:border-muni-red hover:bg-red-50 hover:text-muni-red-dark disabled:opacity-50" aria-label="<%= esFavorita ? 'Quitar de favoritos' : 'Guardar en favoritos' %>: <%= actividad.nombre %>" title="<%= esFavorita ? 'Quitar de favoritos' : 'Guardar en favoritos' %>">
                                        <svg aria-hidden="true" class="h-5 w-5 <%= esFavorita ? 'fill-muni-red-dark text-muni-red-dark' : '' %>" viewBox="0 0 24 24" fill="<%= esFavorita ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 8.8c0 5.4-8.8 10.2-8.8 10.2S3.2 14.2 3.2 8.8a4.3 4.3 0 0 1 8.8-1 4.3 4.3 0 0 1 8.8 1Z"></path></svg>
                                    </button>
                                </form>
                            <% } else { %>
                                <a href="/login?next=<%= encodeURIComponent(currentPath || '/event') %>" class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-black/15 text-muni-ink transition-colors hover:border-muni-red hover:bg-red-50 hover:text-muni-red-dark" aria-label="Inicia sesión para guardar: <%= actividad.nombre %>" title="Guardar en favoritos">
                                    <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 8.8c0 5.4-8.8 10.2-8.8 10.2S3.2 14.2 3.2 8.8a4.3 4.3 0 0 1 8.8-1 4.3 4.3 0 0 1 8.8 1Z"></path></svg>
                                </a>
                            <% } %>
                            <% if (inscripcionAbierta) { %>
                                <a href="/inscripciones/<%= actividad.id %>" class="inline-flex h-10 items-center justify-center rounded-full bg-muni-red-dark px-4 text-xs font-semibold text-white transition-colors hover:bg-red-800" aria-label="Inscribirse: <%= actividad.nombre %>">Inscribirme</a>
                            <% } else { %>
                                <span class="inline-flex h-10 items-center justify-center rounded-full border border-black/10 px-3 text-xs font-medium text-muni-muted" aria-label="Inscripción cerrada para <%= actividad.nombre %>"><%= estado === "activo" ? "Sin cupos" : "Cerrada" %></span>
                            <% } %>
                        </div>
                    </article>
                <% }) %>
            </div>
            <p class="mt-4 text-xs text-muni-muted">Las fechas, los estados y la disponibilidad se consultan desde la base de datos municipal; cada reserva actualiza los cupos.</p>
        <% } %>
    </div>
</section>

<script>
(() => {
    const catalogoSection = document.getElementById("catalogo-actividades");
    if (!catalogoSection || catalogoSection.dataset.filtersBound === "true") return;
    catalogoSection.dataset.filtersBound = "true";

    async function actualizarCatalogo(url) {
        const response = await fetch(url, {
            headers: { "X-Requested-With": "XMLHttpRequest" }
        });
        if (!response.ok) throw new Error("No se pudo actualizar la cartelera.");

        const html = await response.text();
        const documento = new DOMParser().parseFromString(html, "text/html");
        const catalogoActualizado = documento.getElementById("catalogo-actividades");
        if (!catalogoActualizado) throw new Error("La respuesta no contiene la cartelera.");

        if (catalogoActualizado.dataset.mode) {
            catalogoSection.dataset.mode = catalogoActualizado.dataset.mode;
        }
        catalogoSection.innerHTML = catalogoActualizado.innerHTML;
    }

    async function manejarFavorito(form) {
        if (!form) return;
        const submitBtn = form.querySelector('button[type="submit"]');
        if (submitBtn && submitBtn.disabled) return;
        if (submitBtn) submitBtn.disabled = true;

        // Se usa getAttribute('action') porque form.action colisiona con <input name="action">
        const actionUrl = form.getAttribute("action");
        if (!actionUrl) {
            if (submitBtn) submitBtn.disabled = false;
            return;
        }

        try {
            const formData = new FormData(form);
            const response = await fetch(actionUrl, {
                method: "POST",
                body: new URLSearchParams(formData),
                headers: {
                    "X-Requested-With": "XMLHttpRequest",
                    "Accept": "application/json"
                }
            });

            if (response.status === 401 || response.status === 403) {
                const data = await response.json().catch(() => ({}));
                window.location.assign(data.redirect || "/login?expired=1");
                return;
            }

            if (!response.ok) {
                throw new Error("No se pudo actualizar el favorito.");
            }

            const data = await response.json();
            if (!data.ok) {
                throw new Error(data.error || "Error al actualizar favorito.");
            }

            const isFavoritosView = catalogoSection.dataset.mode === "favorites";
            const actionInput = form.querySelector('input[name="action"]');
            const svg = form.querySelector("svg");

            if (data.action === "removed") {
                if (isFavoritosView) {
                    const article = form.closest("article");
                    if (article) {
                        article.style.transition = "opacity 0.25s ease, transform 0.25s ease";
                        article.style.opacity = "0";
                        article.style.transform = "scale(0.98)";
                        setTimeout(() => {
                            article.remove();
                            const remaining = catalogoSection.querySelectorAll("article");
                            if (remaining.length === 0) {
                                actualizarCatalogo(window.location.href).catch(() => {});
                            }
                        }, 250);
                    }
                } else {
                    if (actionInput) actionInput.value = "add";
                    if (submitBtn) {
                        const actividadTitulo = submitBtn.getAttribute("aria-label")?.replace(/^(Quitar de|Guardar en) favoritos:\s*/, "") || "";
                        submitBtn.setAttribute("aria-label", `Guardar en favoritos${actividadTitulo ? ': ' + actividadTitulo : ''}`);
                        submitBtn.setAttribute("title", "Guardar en favoritos");
                    }
                    if (svg) {
                        svg.classList.remove("fill-muni-red-dark", "text-muni-red-dark");
                        svg.setAttribute("fill", "none");
                    }
                }
            } else if (data.action === "added") {
                if (actionInput) actionInput.value = "remove";
                if (submitBtn) {
                    const actividadTitulo = submitBtn.getAttribute("aria-label")?.replace(/^(Quitar de|Guardar en) favoritos:\s*/, "") || "";
                    submitBtn.setAttribute("aria-label", `Quitar de favoritos${actividadTitulo ? ': ' + actividadTitulo : ''}`);
                    submitBtn.setAttribute("title", "Quitar de favoritos");
                }
                if (svg) {
                    svg.classList.add("fill-muni-red-dark", "text-muni-red-dark");
                    svg.setAttribute("fill", "currentColor");
                }
            }
        } catch (error) {
            console.error("Error al actualizar favorito:", error);
            let alertBox = catalogoSection.querySelector("[data-favorite-alert]");
            if (!alertBox) {
                alertBox = document.createElement("div");
                alertBox.dataset.favoriteAlert = "true";
                alertBox.className = "mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-900";
                catalogoSection.prepend(alertBox);
            }
            alertBox.textContent = "No se pudo actualizar el favorito en este momento. Inténtalo nuevamente.";
            setTimeout(() => {
                alertBox?.remove();
            }, 4000);
        } finally {
            if (submitBtn) submitBtn.disabled = false;
        }
    }

    catalogoSection.addEventListener("click", async (event) => {
        const favButton = event.target.closest("button[data-favorite-button]");
        if (favButton && catalogoSection.contains(favButton)) {
            event.preventDefault();
            event.stopPropagation();
            const form = favButton.closest("form[data-favorite-form]");
            await manejarFavorito(form);
            return;
        }

        const enlace = event.target.closest("a[data-catalog-filter]");
        if (!enlace || !catalogoSection.contains(enlace)) return;

        const destino = new URL(enlace.href, window.location.href);
        if (destino.origin !== window.location.origin) return;
        event.preventDefault();
        if (destino.pathname === window.location.pathname && destino.search === window.location.search) return;

        try {
            await actualizarCatalogo(destino.href);
            window.history.pushState({}, "", `${destino.pathname}${destino.search}`);
        } catch (error) {
            window.location.assign(destino.href);
        }
    });

    catalogoSection.addEventListener("submit", async (event) => {
        const form = event.target.closest("form[data-favorite-form]");
        if (!form || !catalogoSection.contains(form)) return;
        event.preventDefault();
        event.stopPropagation();
        await manejarFavorito(form);
    });

    window.addEventListener("popstate", async () => {
        try {
            await actualizarCatalogo(window.location.href);
        } catch (error) {
            window.location.reload();
        }
    });
})();
</script>
