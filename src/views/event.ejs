<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head') %>
    <title><%= title %></title>
</head>
<body class="min-h-screen bg-white font-sans text-muni-ink antialiased">
    <%- include('partials/navigation') %>

    <main id="contenido-principal" class="flex-grow">
        <header class="px-4 pb-7 pt-12 md:px-7 md:pb-10 md:pt-16">
            <div class="mx-auto max-w-[1280px]">
                <nav class="mb-6 flex items-center gap-2 text-xs font-medium text-muni-muted" aria-label="Ruta de navegación">
                    <a href="/" class="hover:text-muni-red-dark">Inicio</a>
                    <span aria-hidden="true">/</span>
                    <span aria-current="page" class="text-muni-ink">Cartelera</span>
                </nav>
                <div class="grid gap-5 md:grid-cols-[1fr_0.7fr] md:items-end md:gap-10">
                    <h1 class="max-w-3xl text-4xl font-semibold leading-[1.02] tracking-[-0.04em] text-muni-ink sm:text-5xl lg:text-6xl">Actividades para mover Talca.</h1>
                    <p class="max-w-xl text-base leading-7 text-muni-muted md:justify-self-end">Revisa talleres y encuentros por categoría, fecha y recinto. La información se actualiza desde la cartelera municipal.</p>
                </div>
                <div class="mt-9 h-[3px] w-20 bg-muni-red-dark" aria-hidden="true"></div>
            </div>
        </header>

        <%- include('partials/catalogo', { catalogoMode: 'full' }) %>

        <section class="px-4 pb-16 md:px-7 md:pb-24">
            <div class="mx-auto flex max-w-[1280px] flex-col gap-5 border-t border-black/10 pt-8 sm:flex-row sm:items-center sm:justify-between">
                <div>
                    <h2 class="text-xl font-semibold tracking-[-0.03em]">¿Tienes una consulta sobre una actividad?</h2>
                    <p class="mt-2 text-sm leading-6 text-muni-muted">La coordinación municipal puede orientarte sobre horarios, recintos e inscripciones.</p>
                </div>
                <a href="/contact" class="inline-flex w-fit items-center gap-2 border-b border-muni-red pb-1 text-sm font-semibold hover:text-muni-red-dark">
                    Contactar a la coordinación
                    <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
                </a>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
