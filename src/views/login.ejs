<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head') %>
    <title><%= title %></title>
</head>
<body class="min-h-screen bg-white font-sans text-muni-ink antialiased">
    <%- include('partials/navigation') %>

    <main id="contenido-principal" class="flex flex-1 items-center px-4 py-14 md:px-7 md:py-20">
        <section class="mx-auto grid w-full max-w-[1100px] overflow-hidden rounded-3xl border border-black/10 bg-white shadow-[0_24px_80px_-48px_rgba(25,25,25,0.25)] md:grid-cols-[0.9fr_1.1fr]" aria-labelledby="login-heading">
            <div class="hidden flex-col justify-between bg-[#8f2632] p-9 text-white md:flex lg:p-12">
                <a href="/" class="text-sm font-semibold tracking-wide text-white/80 hover:text-white">MUNI SPORT · TALCA</a>
                <div class="py-12">
                    <p class="mb-4 text-xs font-semibold uppercase tracking-[0.16em] text-white/70">Tu comunidad se mueve</p>
                    <p class="max-w-sm text-4xl font-semibold leading-[1.05] tracking-[-0.04em]">Encuentra tu próximo espacio para moverte.</p>
                </div>
                <p class="text-xs text-white/70">Cartelera municipal de deporte, salud y encuentro.</p>
            </div>

            <div class="p-6 sm:p-10 lg:p-14">
                <nav class="mb-7 flex items-center gap-2 text-xs font-medium text-muni-muted" aria-label="Ruta de navegación">
                    <a href="/" class="hover:text-muni-red-dark">Inicio</a>
                    <span aria-hidden="true">/</span>
                    <span aria-current="page" class="text-muni-ink">Acceso vecinal</span>
                </nav>
                <h1 id="login-heading" class="text-3xl font-semibold leading-[1.03] tracking-[-0.04em] sm:text-4xl">Qué bueno verte.</h1>
                <p class="mt-3 text-sm leading-6 text-muni-muted">Inicia sesión para guardar actividades y tener la cartelera a mano.</p>

                <% if (notice) { %>
                    <div class="mt-6 border-y border-emerald-300 bg-emerald-50 px-4 py-3 text-sm leading-6 text-emerald-950" role="status"><%= notice %></div>
                <% } %>
                <% if (error) { %>
                    <div class="mt-6 border-y border-red-200 bg-red-50 px-4 py-3 text-sm leading-6 text-red-900" role="alert"><%= error %></div>
                <% } %>

                <form action="/login" method="post" class="mt-7 space-y-5">
                    <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
                    <input type="hidden" name="next" value="<%= next || '/' %>">
                    <div>
                        <label for="email" class="form-label">Correo electrónico</label>
                        <input id="email" name="email" type="email" class="form-control" placeholder="tu@correo.cl" required autocomplete="email" autofocus>
                    </div>
                    <div>
                        <label for="password" class="form-label">Contraseña</label>
                        <input id="password" name="password" type="password" class="form-control" placeholder="Tu contraseña" required autocomplete="current-password">
                    </div>
                    <button type="submit" class="inline-flex min-h-12 w-full items-center justify-center rounded-full bg-muni-red-dark px-6 text-sm font-semibold text-white transition-colors hover:bg-red-800">Iniciar sesión</button>
                </form>

                <p class="mt-6 text-center text-sm text-muni-muted">¿Aún no tienes cuenta? <a href="/register" class="font-semibold text-muni-ink underline decoration-muni-red underline-offset-4 hover:text-muni-red-dark">Crear cuenta vecinal</a></p>
                <p class="mt-7 border-t border-black/10 pt-5 text-center text-xs text-muni-muted"><a href="/admin/login" class="underline underline-offset-4 hover:text-muni-ink">Acceso para organizadores</a></p>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
