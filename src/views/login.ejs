<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <%- include('partials/head') %>
</head>
<body class="login-body">
    <div class="form-body">
        <a href="/">
        <img src="/images/muni.png" alt="Logo" class="navbar-brand" style="width: 50px; aspect-ratio: 1 / 1;">
        </a>
        <p class="text">Inicia sesión</p>
        <form class="login-form">
            <input type="text" placeholder="R.U.N." required>
            <input type="password" placeholder="Contraseña" required>
            <button type="submit">Iniciar sesión</button>
        <a class="text_2" href="/register">Registrate</a>
    </div>
</body>
</html>