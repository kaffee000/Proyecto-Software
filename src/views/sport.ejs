<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head') %>
    <title><%= title %></title>
</head>
<body class="min-h-screen bg-white font-sans text-muni-ink antialiased">
    <%- include('partials/navigation') %>

    <main id="contenido-principal" class="flex-grow">
        <header class="px-4 pb-10 pt-12 md:px-7 md:pb-14 md:pt-16">
            <div class="mx-auto max-w-[1280px]">
                <nav class="mb-6 flex items-center gap-2 text-xs font-medium text-muni-muted" aria-label="Ruta de navegación">
                    <a href="/" class="hover:text-muni-red-dark">Inicio</a>
                    <span aria-hidden="true">/</span>
                    <span aria-current="page" class="text-muni-ink">Disciplinas</span>
                </nav>
                <div class="grid gap-5 md:grid-cols-[1fr_0.72fr] md:items-end md:gap-10">
                    <h1 class="max-w-3xl text-4xl font-semibold leading-[1.02] tracking-[-0.04em] sm:text-5xl lg:text-6xl">Movimiento para cada etapa y barrio.</h1>
                    <p class="max-w-xl text-base leading-7 text-muni-muted md:justify-self-end">Conoce algunas de las disciplinas y espacios comunitarios que forman parte de la oferta deportiva de Talca.</p>
                </div>
                <div class="mt-9 h-[3px] w-20 bg-muni-red-dark" aria-hidden="true"></div>
            </div>
        </header>

        <section class="px-4 pb-16 md:px-7 md:pb-24" aria-labelledby="disciplinas-heading">
            <div class="mx-auto max-w-[1280px]">
                <h2 id="disciplinas-heading" class="sr-only">Disciplinas y talleres</h2>
                <div class="border-t border-black/15">
                    <article class="grid gap-4 border-b border-black/10 py-7 sm:grid-cols-[11rem_minmax(0,1fr)_minmax(12rem,0.68fr)] sm:items-start sm:gap-8 sm:py-8">
                        <div class="flex min-w-0 items-center gap-3 sm:block">
                            <img src="/images/actividad de deporte.webp" alt="" class="h-16 w-24 shrink-0 rounded-lg object-cover sm:mt-3 sm:h-28 sm:w-full" width="320" height="180" loading="lazy">
                            <p class="text-[11px] font-semibold uppercase tracking-[0.1em] text-muni-red-dark sm:text-xs">Deportes formativos</p>
                        </div>
                        <div>
                            <p class="mb-2 text-xs font-medium text-muni-muted">7 a 17 años</p>
                            <h3 class="text-xl font-semibold tracking-[-0.035em] sm:text-2xl">Básquetbol formativo</h3>
                            <p class="mt-2 max-w-[62ch] text-sm leading-6 text-muni-muted">Fundamentos técnicos, pases, tiros y juego colectivo guiado en cancha techada.</p>
                        </div>
                        <div class="flex flex-col gap-2 text-sm leading-6 text-muni-muted sm:pt-5">
                            <p><span class="font-semibold text-muni-ink">Recinto:</span> Polideportivo Municipal</p>
                            <p><span class="font-semibold text-muni-ink">Llevar:</span> zapatillas deportivas y toalla</p>
                            <a href="/event?categoria=deportes" class="mt-2 inline-flex w-fit items-center gap-2 border-b border-muni-red pb-1 font-semibold text-muni-ink hover:text-muni-red-dark">
                                Ver cartelera de deportes
                                <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
                            </a>
                        </div>
                    </article>

                    <article class="grid gap-4 border-b border-black/10 py-7 sm:grid-cols-[11rem_minmax(0,1fr)_minmax(12rem,0.68fr)] sm:items-start sm:gap-8 sm:py-8">
                        <div class="flex min-w-0 items-center gap-3 sm:block">
                            <img src="/images/actividad vacaciones de invierno.webp" alt="" class="h-16 w-24 shrink-0 rounded-lg object-cover sm:mt-3 sm:h-28 sm:w-full" width="320" height="180" loading="lazy">
                            <p class="text-[11px] font-semibold uppercase tracking-[0.1em] text-muni-red-dark sm:text-xs">Deportes formativos</p>
                        </div>
                        <div>
                            <p class="mb-2 text-xs font-medium text-muni-muted">Desde 16 años</p>
                            <h3 class="text-xl font-semibold tracking-[-0.035em] sm:text-2xl">Acondicionamiento funcional</h3>
                            <p class="mt-2 max-w-[62ch] text-sm leading-6 text-muni-muted">Circuitos para trabajar resistencia, postura, movilidad articular y fortalecimiento general.</p>
                        </div>
                        <div class="flex flex-col gap-2 text-sm leading-6 text-muni-muted sm:pt-5">
                            <p><span class="font-semibold text-muni-ink">Recinto:</span> Estadio Sur y Polideportivo</p>
                            <p><span class="font-semibold text-muni-ink">Llevar:</span> ropa deportiva y agua</p>
                            <a href="/event?categoria=deportes" class="mt-2 inline-flex w-fit items-center gap-2 border-b border-muni-red pb-1 font-semibold text-muni-ink hover:text-muni-red-dark">Ver cartelera de deportes <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
                        </div>
                    </article>

                    <article class="grid gap-4 border-b border-black/10 py-7 sm:grid-cols-[11rem_minmax(0,1fr)_minmax(12rem,0.68fr)] sm:items-start sm:gap-8 sm:py-8">
                        <div class="flex min-w-0 items-center gap-3 sm:block">
                            <img src="/images/actividad baile en piscina.webp" alt="" class="h-16 w-24 shrink-0 rounded-lg object-cover sm:mt-3 sm:h-28 sm:w-full" width="320" height="180" loading="lazy">
                            <p class="text-[11px] font-semibold uppercase tracking-[0.1em] text-muni-red-dark sm:text-xs">Salud y bienestar</p>
                        </div>
                        <div>
                            <p class="mb-2 text-xs font-medium text-muni-muted">Todas las edades</p>
                            <h3 class="text-xl font-semibold tracking-[-0.035em] sm:text-2xl">Hidrogimnasia y natación</h3>
                            <p class="mt-2 max-w-[62ch] text-sm leading-6 text-muni-muted">Actividad de bajo impacto en piscina temperada, orientada a la movilidad y el bienestar.</p>
                        </div>
                        <div class="flex flex-col gap-2 text-sm leading-6 text-muni-muted sm:pt-5">
                            <p><span class="font-semibold text-muni-ink">Recinto:</span> Piscina Temperada Municipal</p>
                            <p><span class="font-semibold text-muni-ink">Llevar:</span> gorro y traje de baño</p>
                            <a href="/event?categoria=salud" class="mt-2 inline-flex w-fit items-center gap-2 border-b border-muni-red pb-1 font-semibold text-muni-ink hover:text-muni-red-dark">Ver cartelera de salud <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
                        </div>
                    </article>

                    <article class="grid gap-4 border-b border-black/10 py-7 sm:grid-cols-[11rem_minmax(0,1fr)_minmax(12rem,0.68fr)] sm:items-start sm:gap-8 sm:py-8">
                        <div class="flex min-w-0 items-center gap-3 sm:block">
                            <img src="/images/actividad baile entretenido.webp" alt="" class="h-16 w-24 shrink-0 rounded-lg object-cover sm:mt-3 sm:h-28 sm:w-full" width="320" height="180" loading="lazy">
                            <p class="text-[11px] font-semibold uppercase tracking-[0.1em] text-muni-red-dark sm:text-xs">Salud y bienestar</p>
                        </div>
                        <div>
                            <p class="mb-2 text-xs font-medium text-muni-muted">Público general</p>
                            <h3 class="text-xl font-semibold tracking-[-0.035em] sm:text-2xl">Baile entretenido y yoga</h3>
                            <p class="mt-2 max-w-[62ch] text-sm leading-6 text-muni-muted">Sesiones de actividad aeróbica y relajación corporal en un entorno al aire libre.</p>
                        </div>
                        <div class="flex flex-col gap-2 text-sm leading-6 text-muni-muted sm:pt-5">
                            <p><span class="font-semibold text-muni-ink">Recinto:</span> Parque Costanera Río Claro</p>
                            <p><span class="font-semibold text-muni-ink">Llevar:</span> calzado cómodo y toalla</p>
                            <a href="/event?categoria=salud" class="mt-2 inline-flex w-fit items-center gap-2 border-b border-muni-red pb-1 font-semibold text-muni-ink hover:text-muni-red-dark">Ver cartelera de salud <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
                        </div>
                    </article>

                    <article class="grid gap-4 border-b border-black/10 py-7 sm:grid-cols-[11rem_minmax(0,1fr)_minmax(12rem,0.68fr)] sm:items-start sm:gap-8 sm:py-8">
                        <div class="flex min-w-0 items-center gap-3 sm:block">
                            <img src="/images/actividades adulto mayor.webp" alt="" class="h-16 w-24 shrink-0 rounded-lg object-cover sm:mt-3 sm:h-28 sm:w-full" width="320" height="180" loading="lazy">
                            <p class="text-[11px] font-semibold uppercase tracking-[0.1em] text-muni-red-dark sm:text-xs">Sociales y comunidad</p>
                        </div>
                        <div>
                            <p class="mb-2 text-xs font-medium text-muni-muted">Mayores de 60 años</p>
                            <h3 class="text-xl font-semibold tracking-[-0.035em] sm:text-2xl">Talleres para personas mayores</h3>
                            <p class="mt-2 max-w-[62ch] text-sm leading-6 text-muni-muted">Pausas activas, gimnasia suave y dinámicas comunitarias para promover autonomía y encuentro.</p>
                        </div>
                        <div class="flex flex-col gap-2 text-sm leading-6 text-muni-muted sm:pt-5">
                            <p><span class="font-semibold text-muni-ink">Recinto:</span> Sedes vecinales y Las Américas</p>
                            <p><span class="font-semibold text-muni-ink">Llevar:</span> calzado cerrado antideslizante</p>
                            <a href="/event?categoria=sociales" class="mt-2 inline-flex w-fit items-center gap-2 border-b border-muni-red pb-1 font-semibold text-muni-ink hover:text-muni-red-dark">Ver cartelera social <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
                        </div>
                    </article>

                    <article class="grid gap-4 border-b border-black/10 py-7 sm:grid-cols-[11rem_minmax(0,1fr)_minmax(12rem,0.68fr)] sm:items-start sm:gap-8 sm:py-8">
                        <div class="flex min-w-0 items-center gap-3 sm:block">
                            <img src="/images/actividad vacaciones de invierno 2.webp" alt="" class="h-16 w-24 shrink-0 rounded-lg object-cover sm:mt-3 sm:h-28 sm:w-full" width="320" height="180" loading="lazy">
                            <p class="text-[11px] font-semibold uppercase tracking-[0.1em] text-muni-red-dark sm:text-xs">Sociales y comunidad</p>
                        </div>
                        <div>
                            <p class="mb-2 text-xs font-medium text-muni-muted">Niñas, niños y jóvenes</p>
                            <h3 class="text-xl font-semibold tracking-[-0.035em] sm:text-2xl">Encuentros deportivos barriales</h3>
                            <p class="mt-2 max-w-[62ch] text-sm leading-6 text-muni-muted">Juegos colectivos, circuitos motrices y actividades recreativas en espacios del barrio.</p>
                        </div>
                        <div class="flex flex-col gap-2 text-sm leading-6 text-muni-muted sm:pt-5">
                            <p><span class="font-semibold text-muni-ink">Recinto:</span> Gimnasio Regional y sedes vecinales</p>
                            <p><span class="font-semibold text-muni-ink">Llevar:</span> zapatillas y gorro</p>
                            <a href="/event?categoria=sociales" class="mt-2 inline-flex w-fit items-center gap-2 border-b border-muni-red pb-1 font-semibold text-muni-ink hover:text-muni-red-dark">Ver cartelera social <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
                        </div>
                    </article>
                </div>
            </div>
        </section>

        <section class="bg-muni-soft px-4 py-12 md:px-7 md:py-16" aria-labelledby="disciplina-cta">
            <div class="mx-auto flex max-w-[1280px] flex-col gap-5 border-t border-black/10 pt-8 sm:flex-row sm:items-center sm:justify-between">
                <div>
                    <h2 id="disciplina-cta" class="text-2xl font-semibold tracking-[-0.04em] sm:text-3xl">Busca una actividad para tu barrio.</h2>
                    <p class="mt-2 text-sm leading-6 text-muni-muted">Consulta fechas, lugares y estados en la cartelera municipal.</p>
                </div>
                <a href="/event" class="inline-flex min-h-12 w-fit shrink-0 items-center gap-3 rounded-full bg-muni-red-dark px-6 text-sm font-semibold text-white transition-colors hover:bg-red-800">
                    Explorar la cartelera
                    <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
                </a>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
