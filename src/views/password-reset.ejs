<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head') %>
    <title><%= title %></title>
</head>
<body class="min-h-screen bg-white font-sans text-muni-ink antialiased">
    <%- include('partials/navigation') %>

    <main id="contenido-principal" class="flex flex-1 items-center px-4 py-12 md:px-7 md:py-16">
        <section class="mx-auto w-full max-w-[620px] rounded-3xl border border-black/10 bg-white p-6 sm:p-10 lg:p-12" aria-labelledby="reset-heading">
            <nav class="mb-7 flex items-center gap-2 text-xs font-medium text-muni-muted" aria-label="Ruta de navegación">
                <a href="/" class="hover:text-muni-red-dark">Inicio</a>
                <span aria-hidden="true">/</span>
                <a href="/password/recuperar" class="hover:text-muni-red-dark">Recuperar contraseña</a>
                <span aria-hidden="true">/</span>
                <span aria-current="page" class="text-muni-ink">Nueva contraseña</span>
            </nav>

            <h1 id="reset-heading" class="text-3xl font-semibold leading-[1.03] tracking-[-0.04em] sm:text-4xl">Crea una contraseña nueva.</h1>
            <p id="password-reset-status" data-server-error="<%= error ? 'true' : 'false' %>" class="mt-3 text-sm leading-6 text-muni-muted" role="<%= error ? 'alert' : 'status' %>"><%= error || "Abre el enlace de recuperación que enviamos a tu correo para continuar." %></p>

            <noscript>
                <p class="mt-5 border-y border-red-200 bg-red-50 px-4 py-3 text-sm leading-6 text-red-900" role="alert">Activa JavaScript para validar el enlace seguro de recuperación.</p>
            </noscript>

            <form id="password-reset-form" data-reset-ready="<%= resetReady ? 'true' : 'false' %>" action="/password/restablecer" method="post" class="mt-7 space-y-5" <% if (!resetReady) { %>hidden<% } %>>
                <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
                <input type="hidden" id="accessToken" name="accessToken" value="<%= resetTokens.accessToken || '' %>">
                <input type="hidden" id="refreshToken" name="refreshToken" value="<%= resetTokens.refreshToken || '' %>">
                <input type="hidden" id="recoveryType" name="recoveryType" value="<%= resetReady ? 'recovery' : '' %>">
                <div>
                    <label for="password" class="form-label">Nueva contraseña</label>
                    <input id="password" name="password" type="password" class="form-control" minlength="8" maxlength="72" placeholder="Mínimo 8 caracteres" required autocomplete="new-password">
                </div>
                <div>
                    <label for="passwordConfirmation" class="form-label">Repite la contraseña</label>
                    <input id="passwordConfirmation" name="passwordConfirmation" type="password" class="form-control" minlength="8" maxlength="72" placeholder="Vuelve a escribirla" required autocomplete="new-password">
                </div>
                <button type="submit" class="inline-flex min-h-12 w-full items-center justify-center rounded-full bg-muni-red-dark px-6 text-sm font-semibold text-white transition-colors hover:bg-red-800">Guardar contraseña nueva</button>
            </form>

            <p class="mt-6 border-t border-black/10 pt-5 text-center text-sm text-muni-muted"><a href="/password/recuperar" class="font-semibold text-muni-ink underline decoration-muni-red underline-offset-4 hover:text-muni-red-dark">Solicitar otro enlace</a></p>
        </section>
    </main>

    <script defer src="/recuperar-password.js?v=1"></script>
    <%- include('partials/footer') %>
</body>
</html>
